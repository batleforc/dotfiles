[tools]
kubectl = "latest"
task = "latest"
helm-ls = "latest"
helm = "latest"
gitleaks = "latest"
cocogitto = "latest"
"kkrew:tree" = "latest"
"kkrew:oidc-login" = "latest"
claude = "latest"
jq = "latest"
yq = "latest"
tmux = "latest"
usage = "latest"
rtk = "latest"
"cargo:sofka" = "latest"
sops = "latest"
age = "latest"
gh = "2.104.0"
"github:batleforc/weebo-skillsagent" = "0.17.0"
codex = "latest"

[plugins]
kkrew = "https://github.com/soupglasses/mise-krew"

[settings]
# The chezmoi source tree holds dot_config/mise/config.toml as data to deploy,
# not as a project config: without this, entering it makes mise refuse to run
# ("config files ... are not trusted") and every shim fails there.
ignored_config_paths = [{{ .chezmoi.sourceDir | quote }}]
