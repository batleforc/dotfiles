#!/usr/bin/env python3
# chezmoi modify_ script: DMS rewrites settings.json from its own UI, so the
# repo does not own the whole file. It only pins the keys below and keeps
# everything else exactly as DMS left it.
import json
import sys

PINNED = {
    # BatleHub theme (themes/batlehub/theme.json).
    "currentThemeName": "custom",
    "currentThemeCategory": "registry",
    "customThemeFile": "~/.config/dms/themes/batlehub/theme.json",
    # Short animations instead of none.
    "animationDuration": 250,
    # Match screens by make/model/serial, not by connector: the dock hands the
    # same monitor DP-10 one day and DP-11 the next.
    "displayNameMode": "model",
    # QD-OLED: never leave a static image lit forever (0 = never). Seconds.
    "acMonitorTimeout": 600,
    # Lock when away (0 = never). Shorter on battery: the laptop is out and about.
    "acLockTimeout": 900,
    "batteryMonitorTimeout": 300,
    "batteryLockTimeout": 600,
}

raw = sys.stdin.read()
try:
    settings = json.loads(raw) if raw.strip() else {}
except json.JSONDecodeError:
    # Never destroy a file we cannot parse: hand it back untouched.
    sys.stdout.write(raw)
    sys.exit(0)

settings.update(PINNED)

# Bar: auto-hide on the QD-OLED only (a static bar burns in), fixed elsewhere.
# DMS has no "every screen but X", so each bar lists its screens by model
# (displayNameMode "model"; laptop panel = BOE "0x0BC9"). A screen in neither
# list gets no bar: add its model to FIXED_BAR_SCREENS.
# The OLED bar is rebuilt from the main bar on every apply, so widgets stay in
# sync: edit the main bar in the DMS UI, not the OLED one.
FIXED_BAR_SCREENS = ["0x0BC9", "27G2G8"]
OLED_SCREENS = ["MAG 341C OLED"]
OLED_BAR_ID = "oled"

bars = settings.get("barConfigs")
if isinstance(bars, list) and bars:
    main = next((b for b in bars if b.get("id") == "default"), None)
    if main is None:
        main = next((b for b in bars if b.get("id") != OLED_BAR_ID), None)
if isinstance(bars, list) and bars and main is not None:
    main["screenPreferences"] = FIXED_BAR_SCREENS
    oled = json.loads(json.dumps(main))
    oled.update({
        "id": OLED_BAR_ID,
        "name": "OLED Bar",
        "screenPreferences": OLED_SCREENS,
        "autoHide": True,
    })
    others = [b for b in bars if b.get("id") != OLED_BAR_ID]
    settings["barConfigs"] = others + [oled]

json.dump(settings, sys.stdout, indent=2, ensure_ascii=False)
sys.stdout.write("\n")
