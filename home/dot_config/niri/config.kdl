// niri config. Reference: https://niri-wm.github.io/niri/ (and /usr/share/doc/niri/wiki).
//
// Who owns what:
//   this file      input, layout defaults, window rules, every key bind of my own
//   batlehub.kdl   compositor colours (BatleHub tokens)
//   dms/*.kdl      written by DMS from its settings UI (outputs, gaps, radius,
//                  window rules, a few binds); included last, so they win
// shell.kdl is generated by chezmoi and picks the DMS or Noctalia fragment.

input {
    keyboard {
        xkb {
            // Empty: the layout comes from the system locale (fr AZERTY).
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 16
    center-focused-column "never"
    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 4
    }
    border {
        off
    }
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Ask every app to drop its own titlebar (client-side decorations).
// niri draws no titlebar of its own, so apps that comply lose their close and
// maximize buttons: Mod+Q closes, Mod+F maximizes. GTK apps comply; apps that
// ignore the request (Electron/Chrome, VS Code...) keep theirs. Ghostty drops
// its titlebar either way (window-decoration = none in its config).
// Uncomment to enable; niri reloads on save, but already-open windows keep
// their titlebar until they are reopened.
// prefer-no-csd

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Terminals open at half height; ~/.local/bin/niri-terminal (Mod+T) stacks a
// second one under the first instead of opening a new column.
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    default-window-height { proportion 0.5; }
}

// Adaptive sync only for games. Outputs set `variable-refresh-rate on-demand=true`
// (DMS display settings), so VRR engages only while one of these is on screen:
// QD-OLED panels flicker on dark scenes with VRR always on, so the desktop stays fixed.
window-rule {
    match app-id=r#"^steam_app_"#
    match app-id=r#"^gamescope$"#
    variable-refresh-rate true
}

// Password managers never show up in screenshots, screencasts or screen shares.
window-rule {
    match app-id=r#"^(com\.bitwarden\.desktop|Bitwarden)$"#
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

binds {
    // --- Apps and session ----------------------------------------------------
    // Mod+Space (launcher), Mod+T (terminal), Super+Alt+L (lock) and
    // Mod+Shift+Slash (shortcut cheatsheet) come from dms/binds*.kdl.
    Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }
    Mod+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // Volume, media and brightness keys belong to the desktop shell, so they
    // live in shell-dms.kdl / shell-noctalia.kdl (each shell shows its own OSD).

    // External monitor (MSI MAG 341CQP QD-OLED) over DDC/CI, see ~/.local/bin/monitor-ddc.
    // Not Mod+Alt+S: Super+Alt+S is the screen reader.
    Mod+Alt+Up   hotkey-overlay-title="Écran externe : luminosité +" { spawn-sh "~/.local/bin/monitor-ddc brightness +5"; }
    Mod+Alt+Down hotkey-overlay-title="Écran externe : luminosité -" { spawn-sh "~/.local/bin/monitor-ddc brightness -5"; }
    Mod+Alt+C    hotkey-overlay-title="Écran externe : sRGB / natif" { spawn-sh "~/.local/bin/monitor-ddc srgb"; }
    Mod+Alt+I    hotkey-overlay-title="Écran externe : entrée suivante (KVM)" { spawn-sh "~/.local/bin/monitor-ddc input-next"; }

    // --- Focus and move: columns, windows, monitors -------------------------
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home      { focus-column-first; }
    Mod+End       { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // --- Workspaces ---------------------------------------------------------
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+U               { focus-workspace-down; }
    Mod+I               { focus-workspace-up; }
    Mod+Ctrl+Page_Down  { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up    { move-column-to-workspace-up; }
    Mod+Ctrl+U          { move-column-to-workspace-down; }
    Mod+Ctrl+I          { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Number row of a French AZERTY keyboard, without Shift: & é " ' ( - è _ ç à
    Mod+ampersand  { focus-workspace 1; }
    Mod+eacute     { focus-workspace 2; }
    Mod+quotedbl   { focus-workspace 3; }
    Mod+apostrophe { focus-workspace 4; }
    Mod+parenleft  { focus-workspace 5; }
    Mod+minus      { focus-workspace 6; }
    Mod+egrave     { focus-workspace 7; }
    Mod+underscore { focus-workspace 8; }
    Mod+ccedilla   { focus-workspace 9; }
    Mod+agrave     { focus-workspace 10; }
    Mod+Ctrl+ampersand  { move-column-to-workspace 1; }
    Mod+Ctrl+eacute     { move-column-to-workspace 2; }
    Mod+Ctrl+quotedbl   { move-column-to-workspace 3; }
    Mod+Ctrl+apostrophe { move-column-to-workspace 4; }
    Mod+Ctrl+parenleft  { move-column-to-workspace 5; }
    Mod+Ctrl+minus      { move-column-to-workspace 6; }
    Mod+Ctrl+egrave     { move-column-to-workspace 7; }
    Mod+Ctrl+underscore { move-column-to-workspace 8; }
    Mod+Ctrl+ccedilla   { move-column-to-workspace 9; }
    Mod+Ctrl+agrave     { move-column-to-workspace 10; }

    // --- Column and window sizing -------------------------------------------
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    Mod+C       { center-column; }
    Mod+Ctrl+C  { center-visible-columns; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W       { toggle-column-tabbed-display; }

    // --- Screenshots --------------------------------------------------------
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }
}

// Chezmoi generates shell.kdl, which includes the DMS or Noctalia fragment for this host.
include "shell.kdl"
