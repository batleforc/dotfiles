Include ~/.config/Code/User/globalStorage/batlehub.che-remote-ssh/ssh/che-remote-ssh.conf

Host weebo-dev-setup
    HostName 127.0.0.1
    Port 2022
    User user
    IdentityFile ~/.ssh/che-ws.key
    IdentitiesOnly yes
    PubkeyAuthentication yes
    UserKnownHostsFile /dev/null
    StrictHostKeyChecking no
Host *
    PubkeyAuthentication no
    IdentitiesOnly yes
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github
Host git.weebo.fr
    HostName git.weebo.fr
    IdentityFile ~/.ssh/weebo
Host git.batleforc.fr
    HostName git.batleforc.fr
    IdentityFile ~/.ssh/github
